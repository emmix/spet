{
  "name": "spet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "story point estimation tool",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "relay": "node ./relay.js",
    "spet": "node ./spet.js",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "build:sea": " node ./build-sea.js ./spet.js ./node_modules/@ipshipyard/node-datachannel/build/Release/node_datachannel.node",
    "build:all": "yarn run clean && yarn run build:sea"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.1",
    "@chainsafe/libp2p-noise": "^16.1.4",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/autonat": "^2.0.37",
    "@libp2p/bootstrap": "^11.0.43",
    "@libp2p/circuit-relay-v2": "^3.2.20",
    "@libp2p/identify": "^3.0.37",
    "@libp2p/interface-pubsub": "^4.0.1",
    "@libp2p/logger": "^5.1.21",
    "@libp2p/peer-id-factory": "^4.2.0",
    "@libp2p/pubsub-peer-discovery": "^11.0.2",
    "@libp2p/tcp": "^10.1.17",
    "@libp2p/webrtc": "^5.2.20",
    "@libp2p/websockets": "^9.2.17",
    "@libp2p/webtransport": "^5.0.47",
    "@multiformats/multiaddr": "^12.3.0",
    "@multiformats/multiaddr-matcher": "^1.2.4",
    "date-fns": "^3.6.0",
    "libp2p": "^2.8.12",
    "pretty-ms": "^9.0.0",

    "@libp2p/crypto": "^5.1.12",
    "@libp2p/floodsub": "^11.0.1",
    "@libp2p/kad-dht": "^16.0.1",
    "@libp2p/peer-id": "^6.0.3",
    "@libp2p/ping": "^2.0.0",
    "commander": "^13.1.0",
    "loglevel": "^1.9.2",
    "uint8arrays": "^5.1.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "commander": "^13.1.0",
    "esbuild": "^0.19.12"
  }
}
